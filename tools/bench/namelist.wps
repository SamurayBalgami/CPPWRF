&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2026-10-12_00:00:00',
 end_date   = '2026-10-12_06:00:00',
 interval_seconds = 21600,
 io_form_geogrid = 2,
 debug_level = 0,
/

&geogrid
 parent_id         =   1,
 parent_grid_ratio =   1,
 i_parent_start    =   1,
 j_parent_start    =   1,
 e_we              =  360,
 e_sn              =  270,
 geog_data_res     = 'lowres',
 dx = 15000,
 dy = 15000,
 map_proj = 'lambert',
 ref_lat   =  39.00,
 ref_lon   =  35.00,
 truelat1  =  30.0,
 truelat2  =  60.0,
 stand_lon =  35.0,
 geog_data_path = '/opt/wrfbench/geog/WPS_GEOG_LOW_RES',
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
/
